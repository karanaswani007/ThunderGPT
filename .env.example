# Placeholder values only. Configure real secrets through a secret manager.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BETTER_AUTH_SECRET=replace-with-a-random-secret
BETTER_AUTH_URL=http://localhost:8080

GEMINI_API_KEY=replace-with-gemini-api-key

GEMINI_MODEL_FAST=replace-with-model-id
GEMINI_MODEL_GENERAL=replace-with-model-id
GEMINI_MODEL_REASONING=replace-with-model-id
GEMINI_MODEL_VISION=replace-with-model-id
GEMINI_MODEL_IMAGE=replace-with-model-id

# Public client configuration. Never put credentials in VITE_ variables.
VITE_AUTH_ENABLED=true
VITE_PUBLIC_HOSTNAME=app.example.invalid
VITE_STUN_URLS=stun:stun.example.invalid:3478

